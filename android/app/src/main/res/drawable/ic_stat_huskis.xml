<?xml version="1.0" encoding="utf-8"?>
<!--
  STATUSLINJE-IKONET for native varsler (docs/varsler.md).

  Uten dette bruker @capacitor/local-notifications Androids egen
  `ic_dialog_info` — et fremmed systemikon i statuslinjen på hvert eneste
  Huskis-varsel. Ikonet er derfor ikke pynt: det er forskjellen på at varselet
  ser ut som appens og at det ser ut som ingens.

  Et statuslinje-ikon er en MASKE: Android kaster fargene og tegner formen i sin
  egen farge. Derfor er merket her redusert til de tre kortenes KONTURER — de
  samme rammene som i `ic_launcher_foreground.xml` og `favicon.svg`, men uten
  fyll og uten avkryssingslista, som ville gått i ett ved 24 dp.

  Koordinatene står i favicon-ens eget 24-rutenett; `<group>` skalerer merket
  (som spenner 3.3–20.7) opp til de ytre 22 dp av flaten, slik at de to kan
  sammenlignes linje for linje. Streken er tykkere enn favicon-ens av samme
  grunn som fyllet er borte: en 0.9-strek forsvinner i statuslinjen.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <group
        android:scaleX="1.264"
        android:scaleY="1.264"
        android:translateX="-3.168"
        android:translateY="-3.168">
        <path
            android:pathData="M6.1,3.3 H11.9 A2.8,2.8 0 0 1 14.7,6.1 V11.9 A2.8,2.8 0 0 1 11.9,14.7 H6.1 A2.8,2.8 0 0 1 3.3,11.9 V6.1 A2.8,2.8 0 0 1 6.1,3.3 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M9.1,6.3 H14.9 A2.8,2.8 0 0 1 17.7,9.1 V14.9 A2.8,2.8 0 0 1 14.9,17.7 H9.1 A2.8,2.8 0 0 1 6.3,14.9 V9.1 A2.8,2.8 0 0 1 9.1,6.3 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M12.1,9.3 H17.9 A2.8,2.8 0 0 1 20.7,12.1 V17.9 A2.8,2.8 0 0 1 17.9,20.7 H12.1 A2.8,2.8 0 0 1 9.3,17.9 V12.1 A2.8,2.8 0 0 1 12.1,9.3 Z"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
