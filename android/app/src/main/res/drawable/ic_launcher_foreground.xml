<?xml version="1.0" encoding="utf-8"?>
<!--
  Forgrunnslaget i appikonet: Huskis' eget merke — de tre stablede kortene med
  avkryssingslista på det fremste.

  Tegningen er den SAMME som `favicon.svg` i repo-roten, og koordinatene under
  står med vilje i favicon-ens eget 24-rutenett: `<group>` gjør om til
  ikonets 108-rutenett, slik at de to kan sammenlignes linje for linje. SVG-ens
  `<rect rx>` og `<circle>` finnes ikke i en VectorDrawable og er skrevet ut som
  `pathData`; konverteringen er verifisert pikselidentisk med favicon-en.

  Merket er 56dp bredt, sentrert i 108dp-flaten. Det holder det innenfor
  ADAPTIVE-IKONETS trygge sone (de midterste 72dp) — alt utenfor kan launcheren
  klippe bort med sin egen maske, og gjør det på de fleste telefoner.

  Bakgrunnslaget er `@color/ic_launcher_background` (hvit) — samme flate som
  splash-bildet, som er hvitt i begge drakter (values/styles.xml).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="3.0601"
        android:scaleY="3.0601"
        android:translateX="17.2787"
        android:translateY="17.2787">
        <!-- De tre kortene: fyll + samme blekkstrek som resten av UI-et. -->
        <path
            android:fillColor="#85ad85"
            android:pathData="M6.1,3.3 H11.9 A2.8,2.8 0 0 1 14.7,6.1 V11.9 A2.8,2.8 0 0 1 11.9,14.7 H6.1 A2.8,2.8 0 0 1 3.3,11.9 V6.1 A2.8,2.8 0 0 1 6.1,3.3 Z"
            android:strokeColor="#111111"
            android:strokeWidth="0.9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#adad85"
            android:pathData="M9.1,6.3 H14.9 A2.8,2.8 0 0 1 17.7,9.1 V14.9 A2.8,2.8 0 0 1 14.9,17.7 H9.1 A2.8,2.8 0 0 1 6.3,14.9 V9.1 A2.8,2.8 0 0 1 9.1,6.3 Z"
            android:strokeColor="#111111"
            android:strokeWidth="0.9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:fillColor="#ad8585"
            android:pathData="M12.1,9.3 H17.9 A2.8,2.8 0 0 1 20.7,12.1 V17.9 A2.8,2.8 0 0 1 17.9,20.7 H12.1 A2.8,2.8 0 0 1 9.3,17.9 V12.1 A2.8,2.8 0 0 1 12.1,9.3 Z"
            android:strokeColor="#111111"
            android:strokeWidth="0.9"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Avkryssingslista på det fremste kortet: tre prikker og tre linjer. -->
        <path android:fillColor="#111111" android:pathData="M11.8,12.9 A0.6,0.6 0 1 0 13,12.9 A0.6,0.6 0 1 0 11.8,12.9 Z" />
        <path android:fillColor="#111111" android:pathData="M11.8,15 A0.6,0.6 0 1 0 13,15 A0.6,0.6 0 1 0 11.8,15 Z" />
        <path android:fillColor="#111111" android:pathData="M11.8,17.1 A0.6,0.6 0 1 0 13,17.1 A0.6,0.6 0 1 0 11.8,17.1 Z" />
        <path android:pathData="M14.3,12.9 H18.2" android:strokeColor="#111111" android:strokeWidth="0.9" android:strokeLineCap="round" />
        <path android:pathData="M14.3,15 H18.2" android:strokeColor="#111111" android:strokeWidth="0.9" android:strokeLineCap="round" />
        <path android:pathData="M14.3,17.1 H18.2" android:strokeColor="#111111" android:strokeWidth="0.9" android:strokeLineCap="round" />
    </group>
</vector>
