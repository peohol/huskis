<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Kjøretidstemaet. DayNight, og det er en BEVISST retur til noe #119
      forlot — les hvorfor før du snur det tilbake.

      Foreldretemaet avgjør to ting vi trenger, og begge følger av at appen nå
      har to drakter (docs/mork-drakt.md):

      1. `prefers-color-scheme` INNE i WebView-en. Fra targetSdk 33 utleder
         WebView den av appens eget tema (isLightTheme), ikke av telefonens
         nattmodus. Med et permanent lyst tema svarte den derfor alltid «light»,
         og draktens standardvalg «Følg systemet» ga lys app på en mørk telefon.
         Bekreftet på enhet.
      2. VINDUSBAKGRUNNEN, som er det man ser i båndet bak statusfeltet når
         siden tegner under det (viewport-fit=cover). Den er temaets, ikke
         sidens — derfor var båndet lyst også når appen var mørk.

      #119 forlot DayNight fordi night-varianten malte en «svart stripe» der.
      Med to drakter er den stripen ikke lenger en feil: den ER flaten, og den
      skal være mørk når appen er mørk. Det som var galt den gangen var at
      appen under var lys.

      Glyfene settes ikke her i praksis — `SystemBars`-pluginen overstyrer dem
      i runtime, og står på `DEFAULT` slik at de følger telefonen sammen med
      båndet. Verdiene under gjelder fram til pluginen tar over, altså over
      splash-skjermen; night-varianten ligger i values-night/.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/systemNavScrim</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- Splash-skjermen står før web-laget er oppe, men systemfeltene er de
         samme: mørke glyfer over en lys flate hele veien inn i appen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/systemNavScrim</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
