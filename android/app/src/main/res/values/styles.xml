<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Kjøretidstemaet. Huskis har ÉN drakt, og den er lys — også når telefonen
      står i mørk modus (docs/design-system.md). Derfor:

      • Foreldretemaet er Light, ikke DayNight. Night-varianten malte en svart
        statusfelt-bakgrunn OVER siden, så appens egen flate ikke nådde
        skjermkanten i mørk modus — stikk i strid med `viewport-fit=cover`.
      • Begge systemfeltene er gjennomsiktige, så Huskis' flate er det man ser
        bak klokka og gestelinjen. Målene deres rapporteres fortsatt som
        `env(safe-area-inset-*)`, og CSS-en holder innholdet innenfor.
      • windowLightStatusBar = «feltet ligger på en LYS bakgrunn» ⇒ systemet
        tegner MØRKE glyfer. Uten den beholdt klokka lyse glyfer over vår lyse
        flate, og var i praksis uleselig i lys modus.

      windowLightNavigationBar finnes først fra API 27 og står derfor i
      values-v27/. minSdk er 24: på 24–26 er gestelinjens glyfer systemets
      valg, og feltet er uansett en tynn stripe uten tekst.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- Splash-skjermen står før web-laget er oppe, men systemfeltene er de
         samme: mørke glyfer over en lys flate hele veien inn i appen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
