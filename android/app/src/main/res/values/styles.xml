<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Kjøretidstemaet. Huskis har TO drakter (docs/mork-drakt.md), og hvilken
      som gjelder avgjøres i web-laget — som dette temaet ikke kan se. Temaet
      setter derfor bare UTGANGSPUNKTET, og `SystemBars`-pluginen retter
      glyfene etter telefonens nattmodus i runtime (`style: DEFAULT` i
      capacitor.config.json). Derfor:

      • Foreldretemaet er fortsatt Light, ikke DayNight — også nå som appen kan
        være mørk. Night-varianten malte en svart statusfelt-bakgrunn OVER
        siden, så appens egen flate ikke nådde skjermkanten — stikk i strid med
        `viewport-fit=cover`. Glyfene trenger ikke DayNight for å følge OS-et;
        pluginen gjør den jobben, og den gjør den uten å male noe oppå siden.
      • Statusfeltet er gjennomsiktig, så Huskis' flate er det man ser bak
        klokka. Målene rapporteres fortsatt som `env(safe-area-inset-*)`, og
        CSS-en holder innholdet innenfor.
      • windowLightStatusBar = «feltet ligger på en LYS bakgrunn» ⇒ systemet
        tegner MØRKE glyfer. Den gjelder fram til pluginen tar over, altså over
        SPLASH-skjermen, som er lys i begge drakter — der er mørke glyfer
        riktig svar.
      • BUNNFELTET er derimot en mørk stripe her, ikke gjennomsiktig:
        `windowLightNavigationBar` finnes først fra API 27, og runtime-veien er
        en no-op før det. På 24–26 er treknappsradens glyfer altså LYSE uansett,
        og de trenger noe mørkt å ligge på. Fra API 27 overstyrer
        values-v27/styles.xml både fargen og glyfene — da når flaten vår helt
        ned, med mørke glyfer oppå.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/systemNavScrim</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>


    <!-- Splash-skjermen står før web-laget er oppe, men systemfeltene er de
         samme: mørke glyfer over en lys flate hele veien inn i appen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/systemNavScrim</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
