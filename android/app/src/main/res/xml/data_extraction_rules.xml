<?xml version="1.0" encoding="utf-8"?>
<!-- Ingenting av appens data skal ut av enheten — verken til Googles skykopi
     eller til en ny telefon under oppsett.

     `root` er hele appens private datakatalog, og WebView-lagringen ligger som
     `app_webview/` under den. Det er DEN som betyr noe her: Supabase-sesjonen
     og den lokale bufferen (`mine-lister-v1:<uid>`) ligger i localStorage
     inne i den katalogen.

     Hver seksjon må stå med et eksplisitt `exclude`. En manglende — eller tom —
     seksjon betyr «fullt aktivert» for den modusen, ikke «ingenting».
     `cross-platform-transfer` er derimot opt-in (den krever `bundleId`/`teamId`
     for en app på den andre plattformen) og trenger ingen erklæring her.

     `android:allowBackup="false"` i manifestet dekker skykopien alene; det er
     `device-transfer` her som stopper enhet-til-enhet-overføringen på
     Android 12+. Begrunnelsen i sin helhet: docs/mobilapp-plan.md, «Sikker
     lagring og sikkerhetskopi». -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
